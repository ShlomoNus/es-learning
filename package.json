{
  "name": "es-learning",
  "version": "1.0.0",
  "private": true,
  "description": "Hands-on Elasticsearch learning repo using Node.js, TypeScript, pnpm, tsx, Kibana, and Docker Compose.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:restart": "pnpm infra:down && pnpm infra:up",
    "infra:logs": "docker compose logs -f elasticsearch kibana"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.17.0",
    "dotenv": "^16.4.7",
    "envalid": "^9.0.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
